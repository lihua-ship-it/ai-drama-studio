{
  "buildCommand": "npm install && npm run db:generate && npm run db:migrate:deploy && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/uploads", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
