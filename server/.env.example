PORT=3001

# === 数据库（PostgreSQL）===
# 本地开发同样需要一个 PostgreSQL（可直接复用同一个 Neon 免费库）。
# Vercel 上由 Neon 集成自动注入下列两个变量，无需手填。
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# 迁移（prisma migrate deploy）走直连串，避免 pgbouncer 池化连接的 prepared statement 问题。
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# === 素材存储（Vercel Blob）===
# Vercel 上由 Blob 存储集成自动注入 BLOB_READ_WRITE_TOKEN（@vercel/blob 读取该变量）。
BLOB_READ_WRITE_TOKEN=

UPLOAD_DIR=./uploads

# [已废弃 DEPRECATED] 素材已改为直连 Vercel Blob 公网直链，不再需要本站公网地址；保留仅为向后兼容，可留空。
PUBLIC_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

VOLCENGINE_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_TEXT_MODEL=
# 以下三个为控制台真实模型/资源 ID（非密钥），必填，缺失时生图/生视频/配音会报 CONFIG_MISSING。
SEEDREAM_MODEL=
SEEDANCE_MODEL=

TTS_RESOURCE_ID=
VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
TTS_TEST_VOICE_ID=
SEEDANCE_TEST_IMAGE_URL=
SEEDANCE_TEST_TASK_ID=

# === 智谱 AI（Zhipu，免费生图/生视频）===
# 替代火山方舟。注意：cogvideox-flash 为文生视频，不支持首帧/尾帧图（图生视频在免费模型上不可用）。
ZHIPU_API_KEY=
ZHIPU_IMAGE_MODEL=cogview-3-flash
ZHIPU_VIDEO_MODEL=cogvideox-flash

VIDEO_MAX_POLLS=180
VIDEO_POLL_INTERVAL_MS=10000
